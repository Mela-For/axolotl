{
	"name": "project-axolotl",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"author": "Melanie Forney <mforney@middlebury.edu>",
	"contributors": [
		"Zermina Khan <zwkhan@middlebury.edu>",
		"Jackson McKersie <jmckersie@middlebury.edu>",
		"Cocoroco Kitai <ckitai@middlebury.edu>",
		"Frederick Wessel <fwessel@middlebury.edu>"
	],
	"license": "Apache-2.0",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "tsx server.ts",
		"typecheck": "react-router typegen && tsc",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"test": "vitest",
		"check": "pnpm exec biome check",
		"format": "pnpm exec biome format --write",
		"prepare": "husky"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.0.0",
		"@mui/material": "^9.0.0",
		"@react-router/node": "7.12.0",
		"@react-router/serve": "7.12.0",
		"@supabase/supabase-js": "^2.103.3",
		"@tiptap/extension-placeholder": "^3.22.5",
		"@tiptap/extension-underline": "^3.22.4",
		"@tiptap/react": "^3.22.4",
		"@tiptap/starter-kit": "^3.22.4",
		"isbot": "^5.1.31",
		"lint-staged": "^16.3.1",
		"mui-tiptap": "^1.30.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "7.12.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.6",
		"@playwright/test": "^1.58.2",
		"@react-router/dev": "7.12.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^22",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"lint-staged": "^16.3.2",
		"tsx": "^4.19.2",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.18"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"lint-staged": {
		"*.{css,json,js,jsx,ts,tsx}": "pnpm exec biome check --write",
		"*.{js,jsx,ts,tsx}": "vitest --run --passWithNoTests"
	}
}
